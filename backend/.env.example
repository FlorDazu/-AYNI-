# ============================================================================
# AYNI · Variables de entorno del backend (entorno LOCAL con SQL Server)
# Todas se leen en un solo lugar: backend/app/core/config.py (objeto `settings`).
# Copie este archivo como backend/.env y complete los valores.
# ============================================================================

# --- Base de datos: Microsoft SQL Server (SSMS) ---
# Instancia Express local:  DB_SERVER=localhost\SQLEXPRESS
# Docker (puerto 1433):     DB_SERVER=localhost,1433
DB_SERVER=localhost,1433
DB_NAME=AyniOllasDB
DB_USER=sa
DB_PASSWORD=TuPasswordDocker123!
# Se detecta automáticamente 18 → 17 si el indicado no está instalado.
DB_DRIVER=ODBC Driver 18 for SQL Server
# true = autenticación de Windows (no usa DB_USER ni DB_PASSWORD)
DB_TRUSTED_CONNECTION=false
DB_TIMEOUT=5

# --- CORS (separado por comas; http://localhost:4200 se agrega siempre) ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- JWT ---
JWT_SECRET=ayni_super_secret_jwt_key_2026_cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Recetario externo ---
API_NINJAS_KEY=tu_api_key_de_api_ninjas
# Opcional: Google Cloud Translation API (consola de Google Cloud → APIs → Cloud Translation API).
# Sin clave se usan traductores gratuitos (Google sin clave → MyMemory).
GOOGLE_TRANSLATE_API_KEY=
